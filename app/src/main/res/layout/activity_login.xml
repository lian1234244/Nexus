<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexus_deep_space">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_nexus_logo_animated"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="NEXUS"
        android:textColor="#00FF88"
        android:textSize="28sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.25"
        android:shadowColor="#4D00FF88"
        android:shadowRadius="20"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintBottom_toTopOf="@+id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:text="管理员登录 · 身份验证"
        android:textColor="#8000D4FF"
        android:textSize="10sp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@+id/tilEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="14dp"
        android:backgroundTint="#1E00FF88"
        app:boxBackgroundColor="#1414181A"
        app:boxStrokeColor="#00FF88"
        app:boxStrokeWidthFocused="1dp"
        app:boxCornerRadiusTopStart="2dp"
        app:boxCornerRadiusTopEnd="2dp"
        app:boxCornerRadiusBottomStart="2dp"
        app:boxCornerRadiusBottomEnd="2dp"
        app:hintTextColor="#4000FF88"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toTopOf="@+id/tilPwd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="380dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="管理员邮箱"
            android:inputType="textEmailAddress"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:fontFamily="sans-serif-monospace"
            android:padding="14dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPwd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="18dp"
        app:boxBackgroundColor="#1414181A"
        app:boxStrokeColor="#00FF88"
        app:boxStrokeWidthFocused="1dp"
        app:boxCornerRadiusTopStart="2dp"
        app:boxCornerRadiusTopEnd="2dp"
        app:boxCornerRadiusBottomStart="2dp"
        app:boxCornerRadiusBottomEnd="2dp"
        app:hintTextColor="#4000FF88"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="#4000FF88"
        app:layout_constraintTop_toBottomOf="@id/tilEmail"
        app:layout_constraintBottom_toTopOf="@+id/btnLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="380dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="登录密码"
            android:inputType="textPassword"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:fontFamily="sans-serif-monospace"
            android:padding="14dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="12dp"
        android:text="登 录"
        android:textColor="#00FF88"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.3"
        android:padding="15dp"
        app:backgroundTint="#1400FF88"
        app:strokeColor="#4D00FF88"
        app:strokeWidth="1dp"
        app:cornerRadius="2dp"
        app:layout_constraintTop_toBottomOf="@id/tilPwd"
        app:layout_constraintBottom_toTopOf="@+id/tvError"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="380dp" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="验证失败 · 权限拒绝"
        android:textColor="#FF3366"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.05"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/btnLogin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0" />

</androidx.constraintlayout.widget.ConstraintLayout>
